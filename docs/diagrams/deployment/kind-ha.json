  "cards": [
    {
      "dot": "cyan",
      "title": "Local failure domain",
      "items": [
        "One control plane and three workers on one workstation.",
        "Critical replicas and data instances use worker anti-affinity.",
        "Kind HA uses the direct setup path, not Argo release proof."
      ]
    },
    {
      "dot": "amber",
      "title": "Durability and recovery",
      "items": [
        "Required synchronous PostgreSQL durability remains enabled.",
        "Three brokers retain persistent volumes; Connect reassigns tasks.",
        "Promotion, checkout recovery and client errors are separate results."
      ]
    },
    {
      "dot": "rose",
      "title": "Coverage limits",
      "items": [
        "A worker container loss is not physical-host or AZ failure.",
        "Keycloak and control-plane placement remain constrained.",
        "Monitoring is enabled; queryable tracing remains unproven."
      ]
    }
  ],
